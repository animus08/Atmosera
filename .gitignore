# ==============================================================================
# Atmosera - Root Git Ignore Configuration
# ==============================================================================

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Environment Variables & Secrets (CRITICAL)
.env
.env.local
.env.*.local
*.env

# Python / Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
backend/venv/

# Python Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# SQLite Database Files (Local Instances)
*.db
*.sqlite
*.sqlite3
backend/weathergpt.db
backend/weathergpt.db-journal

# Node.js / Frontend Dependencies & Builds
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Production Build Outputs
dist/
build/
frontend/dist/

# IDE & Editor Files
.idea/
*.sublime-project
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/launch.json

# Local Backups & Scratch
*.bak
*.tmp
.backup_snapshot_v1/
scratch/

