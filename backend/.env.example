# ==============================================================================
# Atmosera Backend Configuration Template
# Duplicate this file as '.env' and populate your optional API credentials.
# Note: Atmosera works out-of-the-box even without paid API keys!
# ==============================================================================

# Core Database Configuration (SQLite default)
DATABASE_URL=sqlite:///./weathergpt.db

# Meteorological Data Provider (Open-Meteo is keyless & free by default)
WEATHER_API_KEY=open-meteo

# AI Conversational Engine (Llama 3.3 via Groq)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Google Gemini Fallback API Key
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Fast2SMS API Key (For rural Indian farmer SMS dispatch)
# Register at: https://www.fast2sms.com/
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Optional: Free WhatsApp Alerts via CallMeBot (No cost)
CALLMEBOT_APIKEY=

# Optional: Cloud Deployment Allowed Origins (comma-separated, e.g. https://my-frontend.vercel.app)
CORS_ORIGINS=

# Optional: Twilio SMS / WhatsApp Gateway
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

